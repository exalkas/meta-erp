                "action": "navigate:/profile",
                "icon": "User"
              },
              {
                "id": "user-settings",
                "label": "navigation.settings",
                "action": "navigate:/settings",
                "icon": "Settings"
              },
              {
                "id": "logout",
                "label": "navigation.logout",
                "action": "logout",
                "icon": "LogOut"
              }
            ],
            "items": []
          }
        }
      ]
    },
