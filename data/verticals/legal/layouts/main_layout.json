  "category": "dashboard",
  "sections_json": {
    "header": {
      "className": "bg-card shadow-sm border-b border-border h-16 flex items-center px-4 z-50",
      "maxComponents": 1,
      "allowedComponents": ["Navigation", "TopBar", "Header"],
      "components": [
        {
          "type": "Navigation",
          "props": {
            "variant": "horizontal",
            "showUserMenu": true,
            "showThemeSelector": true,
            "showLanguageSelector": true,
            "userMenuStyle": "buttons",
            "legalMode": true,
            "logo": {
              "text": "Axiologic",
              "subtitle": "Practice Management",
              "icon": "/axiologic_logo_64.png"
            },

            "userMenu": [
              {
                "id": "user-profile",
