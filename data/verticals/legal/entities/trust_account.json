{
  "entity_name": "TrustAccount",
  "display_label": "Trust Account",
  "plural_label": "Trust Accounts",
  "description": "IOLTA trust accounts for client funds management and compliance",
  "category": "FINANCIAL",
  "is_system_entity": false,
  "vertical": "LEGAL",
  "business_rules": [
    "iolta_compliance",
    "trust_accounting_rules",
    "client_funds_segregation",
    "three_way_reconciliation",
    "state_reporting_requirements"
  ],
  "validation_rules": [
    "required_fields",
    "bank_account_validation",
    "balance_validation"
  ],
  "workflow_triggers": [
    "funds_received",
    "funds_disbursed",
    "reconciliation_required"
  ],
  "audit_enabled": true,
  "soft_delete": false,
  "fields": [
    {
      "field_name": "account_name",
      "label_key": "trust_account.account_name",
      "data_type": "string",
      "is_required": true,
      "max_length": 255,
      "validation_rules": ["required", "max_length:255"],
      "display_order": 1
    },
    {
      "field_name": "account_number",
      "label_key": "trust_account.account_number",
      "data_type": "string",
      "is_required": true,
      "max_length": 50,
      "validation_rules": ["required", "unique", "max_length:50"],
      "help_text": "Bank account number (encrypted)",
      "display_order": 2
    },
    {
      "field_name": "bank_name",
      "label_key": "trust_account.bank_name",
      "data_type": "string",
      "is_required": true,
      "max_length": 255,
      "validation_rules": ["required", "max_length:255"],
      "display_order": 3
    },
    {
      "field_name": "routing_number",
      "label_key": "trust_account.routing_number",
      "data_type": "string",
      "is_required": true,
      "max_length": 20,
      "validation_rules": ["required", "max_length:20", "numeric"],
      "help_text": "Bank routing number",
      "display_order": 4
    },
    {
      "field_name": "account_type",
      "label_key": "trust_account.account_type",
      "data_type": "select",
      "is_required": true,
      "options": ["IOLTA", "Client_Trust", "Escrow", "Retainer"],
      "default_value": "IOLTA",
      "validation_rules": ["required"],
      "display_order": 5
    },
    {
      "field_name": "state_jurisdiction",
      "label_key": "trust_account.state_jurisdiction",
      "data_type": "select",
      "is_required": true,
      "options": [
        "AL",
        "AK",
        "AZ",
        "AR",
        "CA",
        "CO",
        "CT",
        "DE",
        "FL",
        "GA",
        "HI",
        "ID",
        "IL",
        "IN",
        "IA",
        "KS",
        "KY",
        "LA",
        "ME",
        "MD",
        "MA",
        "MI",
        "MN",
        "MS",
        "MO",
        "MT",
        "NE",
        "NV",
        "NH",
        "NJ",
        "NM",
        "NY",
        "NC",
        "ND",
        "OH",
        "OK",
        "OR",
        "PA",
        "RI",
        "SC",
        "SD",
        "TN",
        "TX",
        "UT",
        "VT",
        "VA",
        "WA",
        "WV",
        "WI",
        "WY",
        "DC"
      ],
      "validation_rules": ["required"],
      "help_text": "State jurisdiction for compliance rules",
      "display_order": 6
    },
    {
      "field_name": "current_balance",
      "label_key": "trust_account.current_balance",
      "data_type": "decimal",
      "is_required": false,
      "precision": 12,
      "scale": 2,
      "validation_rules": ["numeric", "min:0"],
      "help_text": "Current account balance",
      "display_order": 7,
      "is_calculated": true
    },
    {
      "field_name": "available_balance",
      "label_key": "trust_account.available_balance",
      "data_type": "decimal",
      "is_required": false,
      "precision": 12,
      "scale": 2,
      "validation_rules": ["numeric", "min:0"],
      "help_text": "Available balance (excluding pending transactions)",
      "display_order": 8,
      "is_calculated": true
    },
    {
      "field_name": "last_reconciled_date",
      "label_key": "trust_account.last_reconciled_date",
      "data_type": "date",
      "is_required": false,
      "validation_rules": ["date"],
      "display_order": 9
    },
    {
      "field_name": "last_reconciled_balance",
      "label_key": "trust_account.last_reconciled_balance",
      "data_type": "decimal",
      "is_required": false,
      "precision": 12,
      "scale": 2,
      "validation_rules": ["numeric"],
      "help_text": "Balance at last reconciliation",
      "display_order": 10
    },
    {
      "field_name": "next_reconciliation_due",
      "label_key": "trust_account.next_reconciliation_due",
      "data_type": "date",
      "is_required": false,
      "validation_rules": ["date", "after:last_reconciled_date"],
      "help_text": "Next required reconciliation date",
      "display_order": 11,
      "is_calculated": true
    },
    {
      "field_name": "account_status",
      "label_key": "trust_account.account_status",
      "data_type": "select",
      "is_required": true,
      "options": ["Active", "Inactive", "Closed", "Frozen", "Under_Review"],
      "default_value": "Active",
      "validation_rules": ["required"],
      "display_order": 12
    },
    {
      "field_name": "interest_earned",
      "label_key": "trust_account.interest_earned",
      "data_type": "decimal",
      "is_required": false,
      "precision": 12,
      "scale": 2,
      "validation_rules": ["numeric", "min:0"],
      "help_text": "Total interest earned (goes to legal aid)",
      "display_order": 13,
      "is_calculated": true
    },
    {
      "field_name": "interest_rate",
      "label_key": "trust_account.interest_rate",
      "data_type": "decimal",
      "is_required": false,
      "precision": 5,
      "scale": 4,
      "validation_rules": ["numeric", "min:0", "max:100"],
      "help_text": "Current interest rate percentage",
      "display_order": 14
    },
    {
      "field_name": "minimum_balance",
      "label_key": "trust_account.minimum_balance",
      "data_type": "decimal",
      "is_required": false,
      "precision": 12,
      "scale": 2,
      "validation_rules": ["numeric", "min:0"],
      "help_text": "Required minimum balance",
      "display_order": 15
    },
    {
      "field_name": "overdraft_protection",
      "label_key": "trust_account.overdraft_protection",
      "data_type": "boolean",
      "is_required": false,
      "default_value": false,
      "help_text": "Overdraft protection enabled",
      "display_order": 16
    },
    {
      "field_name": "responsible_attorney",
      "label_key": "trust_account.responsible_attorney",
      "data_type": "foreign_key",
      "is_required": true,
      "related_entity": "User",
      "validation_rules": ["required", "exists:User,id"],
      "help_text": "Attorney responsible for this trust account",
      "display_order": 17
    },
    {
      "field_name": "backup_attorney",
      "label_key": "trust_account.backup_attorney",
      "data_type": "foreign_key",
      "is_required": false,
      "related_entity": "User",
      "validation_rules": ["exists:User,id"],
      "help_text": "Backup attorney for account management",
      "display_order": 18
    },
    {
      "field_name": "compliance_status",
      "label_key": "trust_account.compliance_status",
      "data_type": "select",
      "is_required": false,
      "options": ["Compliant", "Warning", "Non_Compliant", "Under_Review"],
      "default_value": "Compliant",
      "help_text": "Current compliance status",
      "display_order": 19,
      "is_calculated": true
    },
    {
      "field_name": "last_audit_date",
      "label_key": "trust_account.last_audit_date",
      "data_type": "date",
      "is_required": false,
      "validation_rules": ["date"],
      "display_order": 20
    },
    {
      "field_name": "next_audit_due",
      "label_key": "trust_account.next_audit_due",
      "data_type": "date",
      "is_required": false,
      "validation_rules": ["date", "after:last_audit_date"],
      "display_order": 21
    },
    {
      "field_name": "bank_connection_status",
      "label_key": "trust_account.bank_connection_status",
      "data_type": "select",
      "is_required": false,
      "options": [
        "Connected",
        "Disconnected",
        "Error",
        "Pending",
        "Not_Configured"
      ],
      "default_value": "Not_Configured",
      "help_text": "Bank API connection status",
      "display_order": 22
    },
    {
      "field_name": "auto_reconciliation",
      "label_key": "trust_account.auto_reconciliation",
      "data_type": "boolean",
      "is_required": false,
      "default_value": false,
      "help_text": "Enable automatic reconciliation",
      "display_order": 23
    },
    {
      "field_name": "reconciliation_frequency",
      "label_key": "trust_account.reconciliation_frequency",
      "data_type": "select",
      "is_required": false,
      "options": ["Daily", "Weekly", "Monthly", "Quarterly"],
      "default_value": "Monthly",
      "display_order": 24
    },
    {
      "field_name": "state_reporting_enabled",
      "label_key": "trust_account.state_reporting_enabled",
      "data_type": "boolean",
      "is_required": false,
      "default_value": true,
      "help_text": "Enable automatic state reporting",
      "display_order": 25
    },
    {
      "field_name": "client_count",
      "label_key": "trust_account.client_count",
      "data_type": "integer",
      "is_required": false,
      "validation_rules": ["integer", "min:0"],
      "help_text": "Number of clients with funds in this account",
      "display_order": 26,
      "is_calculated": true
    },
    {
      "field_name": "total_client_balances",
      "label_key": "trust_account.total_client_balances",
      "data_type": "decimal",
      "is_required": false,
      "precision": 12,
      "scale": 2,
      "validation_rules": ["numeric", "min:0"],
      "help_text": "Sum of all individual client balances",
      "display_order": 27,
      "is_calculated": true
    },
    {
      "field_name": "variance_amount",
      "label_key": "trust_account.variance_amount",
      "data_type": "decimal",
      "is_required": false,
      "precision": 12,
      "scale": 2,
      "validation_rules": ["numeric"],
      "help_text": "Variance between bank balance and client ledger",
      "display_order": 28,
      "is_calculated": true
    },
    {
      "field_name": "notes",
      "label_key": "trust_account.notes",
      "data_type": "text",
      "is_required": false,
      "max_length": 2000,
      "help_text": "Administrative notes",
      "display_order": 29
    },
    {
      "field_name": "alerts_enabled",
      "label_key": "trust_account.alerts_enabled",
      "data_type": "boolean",
      "is_required": false,
      "default_value": true,
      "help_text": "Enable compliance and balance alerts",
      "display_order": 30
    }
  ]
}
