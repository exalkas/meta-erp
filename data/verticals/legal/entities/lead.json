{
  "entity_name": "Lead",
  "display_label": "Lead",
  "plural_label": "Leads",
  "description": "Prospective legal clients and business opportunities",
  "category": "CRM",
  "is_system_entity": false,
  "vertical": "LEGAL",
  "business_rules": [
    "ai_lead_scoring",
    "qualification_workflow",
    "conflict_pre_screening",
    "conversion_tracking",
    "nurturing_automation"
  ],
  "validation_rules": ["unique_email", "required_fields", "valid_contact_info"],
  "workflow_triggers": [
    "lead_created",
    "score_updated",
    "status_changed",
    "qualification_completed"
  ],
  "audit_enabled": true,
  "soft_delete": true,
  "fields": [
    {
      "field_name": "lead_name",
      "label_key": "lead.lead_name",
      "data_type": "string",
      "is_required": true,
      "max_length": 255,
      "validation_rules": ["required", "max_length:255"],
      "display_order": 1
    },
    {
      "field_name": "lead_source",
      "label_key": "lead.lead_source",
      "data_type": "select",
      "is_required": true,
      "options": [
        "Website",
        "Referral",
        "Social Media",
        "Google Ads",
        "LinkedIn",
        "Cold Call",
        "Email Campaign",
        "Legal Directory",
        "Bar Association",
        "Networking Event",
        "Other"
      ],
      "validation_rules": ["required"],
      "display_order": 2
    },
    {
      "field_name": "contact_email",
      "label_key": "lead.contact_email",
      "data_type": "email",
      "is_required": true,
      "validation_rules": ["required", "email", "unique"],
      "display_order": 3
    },
    {
      "field_name": "contact_phone",
      "label_key": "lead.contact_phone",
      "data_type": "phone",
      "is_required": false,
      "validation_rules": ["phone_us"],
      "display_order": 4
    },
    {
      "field_name": "legal_issue",
      "label_key": "lead.legal_issue",
      "data_type": "text",
      "is_required": true,
      "max_length": 1000,
      "validation_rules": ["required", "max_length:1000"],
      "help_text": "Brief description of the legal issue or need",
      "display_order": 5
    },
    {
      "field_name": "practice_area",
      "label_key": "lead.practice_area",
      "data_type": "select",
      "is_required": false,
      "options": [
        "Corporate Law",
        "Litigation",
        "Real Estate",
        "Family Law",
        "Criminal Law",
        "Immigration",
        "Intellectual Property",
        "Employment Law",
        "Tax Law",
        "Estate Planning",
        "Personal Injury",
        "Bankruptcy",
        "Other"
      ],
      "display_order": 6
    },
    {
      "field_name": "lead_status",
      "label_key": "lead.lead_status",
      "data_type": "select",
      "is_required": true,
      "options": [
        "New",
        "Contacted",
        "Qualified",
        "Proposal Sent",
        "Won",
        "Lost",
        "Nurturing"
      ],
      "default_value": "New",
      "validation_rules": ["required"],
      "display_order": 7
    },
    {
      "field_name": "lead_score",
      "label_key": "lead.lead_score",
      "data_type": "integer",
      "is_required": false,
      "validation_rules": ["integer", "min:0", "max:100"],
      "help_text": "AI-generated lead score (0-100)",
      "display_order": 8,
      "is_calculated": true
    },
    {
      "field_name": "estimated_value",
      "label_key": "lead.estimated_value",
      "data_type": "decimal",
      "is_required": false,
      "precision": 10,
      "scale": 2,
      "validation_rules": ["numeric", "min:0"],
      "help_text": "Estimated value of potential engagement",
      "display_order": 9
    },
    {
      "field_name": "urgency_level",
      "label_key": "lead.urgency_level",
      "data_type": "select",
      "is_required": false,
      "options": ["Low", "Medium", "High", "Critical"],
      "default_value": "Medium",
      "display_order": 10
    },
    {
      "field_name": "assigned_attorney",
      "label_key": "lead.assigned_attorney",
      "data_type": "foreign_key",
      "is_required": false,
      "related_entity": "User",
      "validation_rules": ["exists:User,id"],
      "display_order": 11
    },
    {
      "field_name": "referral_source_detail",
      "label_key": "lead.referral_source_detail",
      "data_type": "string",
      "is_required": false,
      "max_length": 255,
      "help_text": "Specific referral source (person, website, etc.)",
      "display_order": 12
    },
    {
      "field_name": "budget_range",
      "label_key": "lead.budget_range",
      "data_type": "select",
      "is_required": false,
      "options": [
        "Under $1,000",
        "$1,000 - $5,000",
        "$5,000 - $10,000",
        "$10,000 - $25,000",
        "$25,000 - $50,000",
        "$50,000 - $100,000",
        "Over $100,000",
        "Not Specified"
      ],
      "default_value": "Not Specified",
      "display_order": 13
    },
    {
      "field_name": "timeline_expectations",
      "label_key": "lead.timeline_expectations",
      "data_type": "select",
      "is_required": false,
      "options": [
        "Immediate (Within 1 week)",
        "Urgent (Within 1 month)",
        "Normal (1-3 months)",
        "Planning (3-6 months)",
        "Future (6+ months)",
        "Not Specified"
      ],
      "default_value": "Not Specified",
      "display_order": 14
    },
    {
      "field_name": "qualification_notes",
      "label_key": "lead.qualification_notes",
      "data_type": "text",
      "is_required": false,
      "max_length": 2000,
      "help_text": "Notes from qualification conversation",
      "display_order": 15
    },
    {
      "field_name": "conversion_probability",
      "label_key": "lead.conversion_probability",
      "data_type": "integer",
      "is_required": false,
      "validation_rules": ["integer", "min:0", "max:100"],
      "help_text": "Probability of conversion to client (%)",
      "display_order": 16,
      "is_calculated": true
    },
    {
      "field_name": "last_contact_date",
      "label_key": "lead.last_contact_date",
      "data_type": "datetime",
      "is_required": false,
      "validation_rules": ["datetime"],
      "display_order": 17,
      "is_calculated": true
    },
    {
      "field_name": "next_follow_up_date",
      "label_key": "lead.next_follow_up_date",
      "data_type": "datetime",
      "is_required": false,
      "validation_rules": ["datetime", "after:last_contact_date"],
      "display_order": 18
    },
    {
      "field_name": "communication_preference",
      "label_key": "lead.communication_preference",
      "data_type": "select",
      "is_required": false,
      "options": ["Email", "Phone", "Text", "In-Person", "Video Call"],
      "default_value": "Email",
      "display_order": 19
    },
    {
      "field_name": "marketing_consent",
      "label_key": "lead.marketing_consent",
      "data_type": "boolean",
      "is_required": false,
      "default_value": false,
      "help_text": "Consent to receive marketing communications",
      "display_order": 20
    }
  ]
}
