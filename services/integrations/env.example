# Integrations Service Configuration
SERVICE_NAME=integrations
SERVICE_PORT=8003

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metadata_erp

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Application Settings
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=

# Greek Tax Integration (AADE/myDATA)
AADE_API_URL=https://mydataapidev.aade.gr
AADE_USER_ID=your-aade-user-id
AADE_SUBSCRIPTION_KEY=your-subscription-key
ENABLE_AADE_INTEGRATION=true

# Banking Integration
ENABLE_BANKING_INTEGRATION=false
BANKING_API_URL=https://api.bank.gr
BANKING_CLIENT_ID=your-banking-client-id
BANKING_CLIENT_SECRET=your-banking-secret

# ERP Integrations
ENABLE_SAP_INTEGRATION=false
ENABLE_SALESFORCE_INTEGRATION=false

# Email Integration
ENABLE_EMAIL_INTEGRATION=true
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT=30

# Service URLs
API_SERVICE_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8001 