# API Service Configuration
SERVICE_NAME=api
SERVICE_PORT=8000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metadata_erp

# Redis Configuration  
REDIS_URL=redis://localhost:6379

# Application Settings
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=
JWT_SECRET_KEY=

# Service URLs
AUTH_SERVICE_URL=http://localhost:8001
FILES_SERVICE_URL=http://localhost:8002
INTEGRATIONS_SERVICE_URL=http://localhost:8003
AI_VOICE_SERVICE_URL=http://localhost:8004
AI_SUPPORT_SERVICE_URL=http://localhost:8005

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3006

# Features
ENABLE_METADATA_CACHE=true
ENABLE_FIELD_VALIDATION=true
ENABLE_LAYOUT_PREVIEW=true 