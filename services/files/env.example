# Files Service Configuration
SERVICE_NAME=files
SERVICE_PORT=8002

# Database Configuration (for file metadata)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metadata_erp

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Application Settings
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=

# Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./storage
MAX_FILE_SIZE=50MB
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,png,jpg,jpeg,gif,csv,txt

# AWS S3 (Optional - for production)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_BUCKET_NAME=your-bucket-name
# AWS_REGION=eu-west-1

# Azure Blob Storage (Optional)
# AZURE_STORAGE_ACCOUNT=your-account
# AZURE_STORAGE_KEY=your-key
# AZURE_CONTAINER_NAME=your-container

# Service URLs
API_SERVICE_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8001

# File Processing
ENABLE_VIRUS_SCAN=false
ENABLE_IMAGE_PROCESSING=true
ENABLE_PDF_PREVIEW=true 