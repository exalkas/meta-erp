# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metadata_erp
DATABASE_TEST_URL=postgresql://postgres:postgres@localhost:5432/metadata_erp_test

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_URL=redis://localhost:6379

# ==============================================
# APPLICATION SETTINGS
# ==============================================
ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# ==============================================
# SECURITY & AUTH
# ==============================================
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_TLS=true
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME=Metadata ERP

# ==============================================
# GREEK TAX INTEGRATION (AADE/myDATA)
# ==============================================
AADE_API_URL=https://mydataapidev.aade.gr
AADE_USER_ID=your-aade-user-id
AADE_SUBSCRIPTION_KEY=your-subscription-key

# ==============================================
# STORAGE CONFIGURATION
# ==============================================
STORAGE_TYPE=local
STORAGE_PATH=./storage
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_BUCKET_NAME=your-bucket-name
# AWS_REGION=eu-west-1

# ==============================================
# MONITORING & LOGGING
# ==============================================
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-url

# ==============================================
# FEATURES FLAGS
# ==============================================
ENABLE_VOICE_COMMANDS=false
ENABLE_AI_ASSISTANCE=false
ENABLE_GREEK_TAX_ENGINE=true
ENABLE_PASSKEY_AUTH=false 