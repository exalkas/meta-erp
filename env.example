# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DATABASE_URL=
DATABASE_TEST_URL=

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_URL=redis://localhost:6379

# ==============================================
# APPLICATION SETTINGS
# ==============================================
ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# ==============================================
# SECURITY & AUTH
# ==============================================
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=
SMTP_TLS=true
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME=Metadata ERP

# ==============================================
# GREEK TAX INTEGRATION (AADE/myDATA)
# ==============================================
AADE_API_URL=https://mydataapidev.aade.gr
AADE_USER_ID=your-aade-user-id
AADE_SUBSCRIPTION_KEY=

# ==============================================
# STORAGE CONFIGURATION
# ==============================================
STORAGE_TYPE=local
STORAGE_PATH=./storage
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_BUCKET_NAME=your-bucket-name
# AWS_REGION=eu-west-1

# ==============================================
# MONITORING & LOGGING
# ==============================================
LOG_LEVEL=INFO
SENTRY_DSN=your-sentry-dsn-url

# ==============================================
# FEATURES FLAGS
# ==============================================
ENABLE_VOICE_COMMANDS=false
ENABLE_AI_ASSISTANCE=false
ENABLE_GREEK_TAX_ENGINE=true
ENABLE_PASSKEY_AUTH=

# Docker uses the postgres service hostname; local scripts use localhost.
POSTGRES_PASSWORD=
DOCKER_DATABASE_URL=
DOCKER_TENANT_DB_TEMPLATE=
TEST_DATABASE_URL=
ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
# Administrative database connection for explicit create/reset utilities only.
ADMIN_DATABASE_URL=
