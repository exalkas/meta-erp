        { "value": "processing", "label": "Processing", "sort_order": 2 },
        { "value": "shipped", "label": "Shipped", "sort_order": 3 },
        { "value": "delivered", "label": "Delivered", "sort_order": 4 },
        { "value": "cancelled", "label": "Cancelled", "sort_order": 5 }
      ]
    }
  ],

  "installation": {
    "dependencies": [
      "payment_processor",
      "email_service",
      "notification_system"
    ],
    "database_migrations": [
      "create_ecommerce_tables.sql",
      "seed_default_data.sql",
      "create_indexes.sql"
    ],
    "configuration_steps": [
      {
        "step": 1,
        "title": "Configure Payment Processor",
        "description": "Set up Stripe or PayPal integration",
        "required": true
      },
      {
        "step": 2,
        "title": "Import Product Catalog",
        "description": "Upload initial product data via CSV",
        "required": false
      },
      {
        "step": 3,
        "title": "Configure Email Templates",
        "description": "Customize order confirmation and notification emails",
        "required": true
      },
      {
        "step": 4,
        "title": "Set up Integrations",
        "description": "Connect to Shopify, inventory systems, or other platforms",
        "required": false
      }
    ]
  }
