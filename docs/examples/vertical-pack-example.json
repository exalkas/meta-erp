  "workflows": [
    {
      "name": "low_stock_alert",
      "display_name": "Low Stock Alert",
      "description": "Automatically notify when product stock is low",
      "trigger_type": "field_change",
      "trigger_conditions": {
        "entity": "Product",
        "field": "stock_quantity",
        "operator": "lte",
        "value": 10
      },
      "actions": [
        {
          "type": "send_notification",
          "config": {
            "recipients": ["inventory@company.com"],
            "subject": "Low Stock Alert: {{product.name}}",
            "template": "low_stock_email"
          }
        },
        {
          "type": "create_task",
          "config": {
            "title": "Restock {{product.name}}",
            "assignee": "inventory_manager",
            "priority": "high"
          }
        }
      ]
    },
    {
      "name": "order_fulfillment",
      "display_name": "Order Fulfillment Process",
      "description": "Automated order processing workflow",
      "trigger_type": "record_create",
      "trigger_conditions": {
        "entity": "Order"
      },
      "actions": [
        {
          "type": "send_email",
          "config": {
            "to": "{{order.customer_email}}",
            "subject": "Order Confirmation - {{order.order_number}}",
            "template": "order_confirmation"
          }
        },
        {
          "type": "update_inventory",
          "config": {
            "decrease_stock": true
          }
        },
        {
          "type": "create_task",
          "config": {
            "title": "Process Order {{order.order_number}}",
            "assignee": "fulfillment_team",
            "due_date": "+1 day"
          }
        }
      ]
    }
  ],

  "integrations": [
    {
      "name": "shopify_sync",
      "display_name": "Shopify Integration",
      "description": "Two-way sync with Shopify store",
      "type": "api_integration",
      "config": {
        "api_url": "https://{{shop_name}}.myshopify.com/admin/api/2023-10",
        "auth_type": "api_key",
        "sync_entities": ["products", "orders", "customers"],
        "sync_frequency": "15_minutes"
      }
    },
    {
      "name": "stripe_payments",
      "display_name": "Stripe Payments",
      "description": "Payment processing via Stripe",
      "type": "payment_processor",
      "config": {
        "api_url": "https://api.stripe.com/v1",
        "auth_type": "secret_key",
        "supported_currencies": ["USD", "EUR", "GBP"],
        "webhook_events": ["payment_succeeded", "payment_failed"]
      }
    }
  ],

  "picklists": [
    {
      "name": "product_categories",
      "values": [
        { "value": "electronics", "label": "Electronics", "sort_order": 1 },
        { "value": "clothing", "label": "Clothing", "sort_order": 2 },
        { "value": "books", "label": "Books", "sort_order": 3 },
        { "value": "home_garden", "label": "Home & Garden", "sort_order": 4 },
        { "value": "sports", "label": "Sports & Outdoors", "sort_order": 5 }
      ]
