  "entities": [
    {
      "entity_name": "Product",
      "display_label": "Product",
      "plural_label": "Products",
      "description": "E-commerce product catalog",
      "icon": "package",
      "color": "#10B981",
      "vertical": "ecommerce",
      "supports_attachments": true,
      "supports_comments": true,
      "api_name": "products",
      "fields": [
        {
          "field_name": "name",
          "label_key": "product.name",
          "data_type": "text",
          "is_required": true,
          "is_searchable": true,
          "is_sortable": true,
          "is_filterable": true,
          "validation_rules": {
            "minLength": 2,
            "maxLength": 100
          }
        },
        {
          "field_name": "sku",
          "label_key": "product.sku",
          "data_type": "text",
          "is_required": true,
          "is_searchable": true,
          "validation_rules": {
            "pattern": "^[A-Z0-9-]+$"
          }
        },
        {
          "field_name": "price",
          "label_key": "product.price",
          "data_type": "currency",
          "is_required": true,
          "is_sortable": true,
          "is_filterable": true,
          "validation_rules": {
            "min": 0.01
          }
        },
        {
          "field_name": "category",
          "label_key": "product.category",
          "data_type": "picklist",
          "picklist_name": "product_categories",
          "is_filterable": true,
          "is_required": true
        },
        {
          "field_name": "stock_quantity",
          "label_key": "product.stock",
          "data_type": "integer",
          "is_sortable": true,
          "is_filterable": true,
          "default_value": 0
        },
        {
          "field_name": "description",
          "label_key": "product.description",
          "data_type": "textarea",
          "is_searchable": true
        },
        {
          "field_name": "is_active",
          "label_key": "product.active",
          "data_type": "boolean",
          "default_value": true,
          "is_filterable": true
        }
      ]
    },
    {
      "entity_name": "Order",
      "display_label": "Order",
      "plural_label": "Orders",
      "description": "Customer orders and sales",
      "icon": "shopping-cart",
      "color": "#3B82F6",
      "vertical": "ecommerce",
      "supports_workflows": true,
      "api_name": "orders",
      "fields": [
        {
          "field_name": "order_number",
          "label_key": "order.number",
          "data_type": "text",
          "is_required": true,
          "is_searchable": true,
          "validation_rules": {
            "pattern": "^ORD-[0-9]{6}$"
          }
        },
        {
          "field_name": "customer_email",
          "label_key": "order.customer_email",
          "data_type": "email",
          "is_required": true,
          "is_searchable": true,
          "is_filterable": true
        },
        {
          "field_name": "total_amount",
          "label_key": "order.total",
          "data_type": "currency",
          "is_required": true,
          "is_sortable": true,
          "is_filterable": true
        },
        {
          "field_name": "status",
          "label_key": "order.status",
          "data_type": "picklist",
          "picklist_name": "order_statuses",
          "is_filterable": true,
          "is_required": true,
          "default_value": "pending"
        },
        {
          "field_name": "order_date",
          "label_key": "order.date",
          "data_type": "datetime",
          "is_sortable": true,
          "is_filterable": true,
          "default_value": "NOW()"
        }
      ]
    },
    {
      "entity_name": "Customer",
      "display_label": "Customer",
      "plural_label": "Customers",
      "description": "Customer information and profiles",
      "icon": "users",
      "color": "#8B5CF6",
      "vertical": "ecommerce",
      "supports_attachments": true,
      "api_name": "customers",
      "fields": [
        {
          "field_name": "email",
          "label_key": "customer.email",
          "data_type": "email",
          "is_required": true,
          "is_searchable": true,
          "is_filterable": true
        },
        {
          "field_name": "first_name",
          "label_key": "customer.first_name",
          "data_type": "text",
          "is_required": true,
          "is_searchable": true
        },
        {
          "field_name": "last_name",
          "label_key": "customer.last_name",
          "data_type": "text",
          "is_required": true,
          "is_searchable": true
        },
        {
          "field_name": "phone",
          "label_key": "customer.phone",
          "data_type": "phone",
          "is_searchable": true
        },
        {
          "field_name": "total_orders",
          "label_key": "customer.total_orders",
          "data_type": "integer",
          "is_sortable": true,
          "is_filterable": true,
          "default_value": 0
        },
        {
          "field_name": "lifetime_value",
          "label_key": "customer.lifetime_value",
          "data_type": "currency",
          "is_sortable": true,
          "is_filterable": true,
          "default_value": 0
        }
      ]
    }
  ],

