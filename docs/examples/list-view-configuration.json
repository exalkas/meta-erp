  "default_sort_field": "created_at",
  "default_sort_order": "DESC",
  "default_page_size": 25,

  "quick_filters": [
    {
      "field": "status",
      "label": "Active",
      "value": "active",
      "operator": "equals",
      "icon": "check-circle"
    },
    {
      "field": "status",
      "label": "Prospects",
      "value": "prospect",
      "operator": "equals",
      "icon": "eye"
    },
    {
      "field": "created_at",
      "label": "This Month",
      "value": "2024-01-01",
      "operator": "gte",
      "icon": "calendar"
    }
  ],

  "advanced_filters": {
    "enabled": true,
    "operators": [
      "equals",
      "not_equals",
      "contains",
      "not_contains",
      "starts_with",
      "ends_with",
      "is_empty",
      "is_not_empty",
      "greater_than",
      "less_than",
      "between",
      "in",
      "not_in"
    ],
    "date_ranges": [
      "today",
      "yesterday",
      "this_week",
      "last_week",
      "this_month",
      "last_month",
      "this_year"
    ],
    "numeric_ranges": true
  },

  "search_enabled": true,
  "search_fields": ["full_name", "email", "company_name"],
  "global_search": true,

  "pagination_enabled": true,
  "page_size_options": [10, 25, 50, 100, 200],
  "show_total_count": true,

  "export_enabled": true,
  "export_formats": ["csv", "excel", "pdf"],

  "bulk_actions": [
    {
      "id": "bulk_delete",
      "label": "Delete Selected",
      "icon": "trash",
