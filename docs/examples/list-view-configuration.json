    },
    {
      "id": "bulk_email",
      "label": "Send Email",
      "icon": "mail",
      "requires_selection": true
    },
    {
      "id": "bulk_export",
      "label": "Export Selected",
      "icon": "download",
      "requires_selection": true
    }
  ],

  "row_actions": [
    {
      "id": "view_contact",
      "label": "View",
      "icon": "eye",
      "route": "/contacts/{id}"
    },
    {
      "id": "edit_contact",
      "label": "Edit",
      "icon": "edit",
      "route": "/contacts/{id}/edit"
    },
    {
      "id": "delete_contact",
      "label": "Delete",
      "icon": "trash",
      "action": "delete",
      "confirm_message": "Are you sure you want to delete this contact?"
